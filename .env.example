# --- Instagram / Meta app ---
# App secret from your Meta app's Basic Settings.
IG_APP_SECRET=

# Any string you make up yourself — must match the "Verify token" you enter
# in the Meta app's webhook subscription config.
IG_VERIFY_TOKEN=

# Long-lived access token for the @infathomreel.ai account, generated after
# connecting it via Instagram API with Instagram Login. See README.md.
IG_PAGE_ACCESS_TOKEN=

# --- Google Gemini (free tier, no card required) ---
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional override. Must be a video-capable Gemini model.
ANALYSIS_MODEL=gemini-2.5-flash
